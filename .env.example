# alivecap — environment variables
# Copy to `.env` for local development and set the same values in your host
# (e.g. Vercel → Project Settings → Environment Variables).
# NEVER commit real values. NEVER prefix a privileged key with VITE_.

# ---------------------------------------------------------------------------
# Public (browser-visible) — required
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# Optional convenience value used for display/links only.
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ---------------------------------------------------------------------------
# Server-only (never exposed to the browser) — required
# ---------------------------------------------------------------------------
# Mirrors of the public values, read by SSR / server functions.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<project-ref>"

# No service-role key is required: every guest and host operation runs through
# Row Level Security using the publishable key plus the caller's own session.
# (Guests get an anonymous Supabase session; enable Anonymous sign-ins in Auth.)

# Canonical public URL used by guest QR codes (no trailing path).
VITE_PUBLIC_APP_URL="https://your-alivecap-domain.example"
